        {"k": "box", "at": [408, 24, 146, 62], "role": "model", "title": "FormulaDocument", "subs": ["tl-syntax graph", "byte spans"]},
        {"k": "box", "at": [607, 24, 146, 62], "role": "logic", "title": "format_document", "subs": ["canonical form", "bounded"]},
        {"k": "box", "at": [808, 24, 172, 62], "role": "code", "title": "canonical text", "subs": ["{canonical}", "no whitespace"]},
        {"k": "line", "points": [[184, 55], [234, 55]], "role": "code"},
        {"k": "note", "at": [210, 47], "text": "text", "role": "code", "anchor": "middle"},
        {"k": "line", "points": [[355, 55], [405, 55]], "role": "model"},
        {"k": "note", "at": [381, 47], "text": "graph", "role": "model", "anchor": "middle"},
        {"k": "line", "points": [[554, 55], [604, 55]], "role": "model"},
        {"k": "note", "at": [580, 47], "text": "graph", "role": "model", "anchor": "middle"},
        {"k": "line", "points": [[753, 55], [805, 55]], "role": "code"},
        {"k": "note", "at": [781, 47], "text": "text", "role": "code", "anchor": "middle"},
        {"k": "box", "at": [0, 170, 184, 56], "role": "ink", "title": "semantic profile", "subs": ["{profile}"]},
        {"k": "line", "points": [[184, 198], [296, 198], [296, 89]], "role": "ink"},
